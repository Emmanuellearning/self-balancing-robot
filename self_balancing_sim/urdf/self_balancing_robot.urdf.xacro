<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="self_balancing_robot">

  <!-- Robot Mechanical Parameters -->
  <xacro:property name="chassis_mass" value="2.0"/>
  <xacro:property name="chassis_width" value="0.20"/>
  <xacro:property name="chassis_depth" value="0.10"/>
  <xacro:property name="chassis_height" value="0.40"/>

  <xacro:property name="wheel_mass" value="0.25"/>
  <xacro:property name="wheel_radius" value="0.06"/>
  <xacro:property name="wheel_width" value="0.03"/>
  <xacro:property name="wheel_separation" value="0.24"/>

  <!-- Dummy root link to satisfy KDL / RSP -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Base Link / Chassis -->
  <!-- Center of mass is placed above the axle to act as an inverted pendulum -->
  <link name="base_link">
    <!-- Visual Representation of Pendulum Body -->
    <visual>
      <origin xyz="0 0 ${chassis_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_depth} ${chassis_width} ${chassis_height}"/>
      </geometry>
      <material name="cyan">
        <color rgba="0.1 0.6 0.8 1.0"/>
      </material>
    </visual>

    <!-- Collision Representation -->
    <collision>
      <origin xyz="0 0 ${chassis_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_depth} ${chassis_width} ${chassis_height}"/>
      </geometry>
    </collision>

    <!-- Inertia -->
    <inertial>
      <origin xyz="0 0 ${chassis_height/2}" rpy="0 0 0"/>
      <mass value="${chassis_mass}"/>
      <inertia
        ixx="${(1/12) * chassis_mass * (chassis_width*chassis_width + chassis_height*chassis_height)}"
        ixy="0.0" ixz="0.0"
        iyy="${(1/12) * chassis_mass * (chassis_depth*chassis_depth + chassis_height*chassis_height)}"
        iyz="0.0"
        izz="${(1/12) * chassis_mass * (chassis_depth*chassis_depth + chassis_width*chassis_width)}"/>
    </inertial>
  </link>

  <!-- Gazebo Material and IMU sensor for base_link -->
  <gazebo reference="base_link">
    <material>
      <ambient>0.1 0.6 0.8 1.0</ambient>
      <diffuse>0.1 0.6 0.8 1.0</diffuse>
      <specular>0.5 0.5 0.5 1.0</specular>
    </material>
    <sensor name="imu_sensor" type="imu">
      <always_on>1</always_on>
      <update_rate>100.0</update_rate>
      <visualize>true</visualize>
      <topic>imu</topic>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>2e-4</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>2e-4</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>2e-4</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-2</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-2</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-2</stddev></noise></z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

  <!-- Left Wheel Macro -->
  <xacro:macro name="wheel" params="prefix y_offset">
    <link name="${prefix}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="dark_gray">
          <color rgba="0.2 0.2 0.2 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>2.0</mu>
              <mu2>2.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <mass value="${wheel_mass}"/>
        <inertia
          ixx="${(1/12)*wheel_mass*(3*wheel_radius*wheel_radius + wheel_width*wheel_width)}"
          ixy="0.0" ixz="0.0"
          iyy="${(1/12)*wheel_mass*(3*wheel_radius*wheel_radius + wheel_width*wheel_width)}"
          iyz="0.0"
          izz="${0.5 * wheel_mass * wheel_radius * wheel_radius}"/>
      </inertial>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel_link"/>
      <origin xyz="0 ${y_offset} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.001" friction="0.001"/>
    </joint>

    <gazebo reference="${prefix}_wheel_link">
      <material>
        <ambient>0.2 0.2 0.2 1.0</ambient>
        <diffuse>0.2 0.2 0.2 1.0</diffuse>
        <specular>0.5 0.5 0.5 1.0</specular>
      </material>
      <mu1>2.0</mu1>
      <mu2>2.0</mu2>
    </gazebo>
  </xacro:macro>

  <xacro:wheel prefix="left" y_offset="${wheel_separation/2}"/>
  <xacro:wheel prefix="right" y_offset="${-wheel_separation/2}"/>

  <!-- Gazebo Diff Drive Plugin -->
  <gazebo>
    <plugin
      filename="gz-sim-diff-drive-system"
      name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>${wheel_separation}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <max_linear_acceleration>50.0</max_linear_acceleration>
      <min_linear_acceleration>-50.0</min_linear_acceleration>
      <max_angular_acceleration>50.0</max_angular_acceleration>
      <min_angular_acceleration>-50.0</min_angular_acceleration>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publisher_frequency>100</odom_publisher_frequency>
      <tf_topic>tf</tf_topic>
    </plugin>
  </gazebo>

</robot>
